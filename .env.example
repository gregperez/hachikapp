# Copy to .env (gitignored) and export before starting the app, or inject via your process manager.
# Never commit real values. Generate with: openssl rand -base64 48

DB_HOST=localhost
DB_PORT=5432
DB_NAME=base_golang
DB_USER=postgres
DB_PASSWORD=change-me-db-password-not-for-production
DB_SSLMODE=disable
DB_MAX_CONNS=10

APP_ENV=development
LOG_LEVEL=info
SERVER_ADDR=:8080
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Public web origin used to build tag links. Absolute http(s), no path; https in production.
PUBLIC_BASE_URL=http://localhost:3000
# Secret keying the anonymous visitor hash. Production: >= 32 chars, not the default.
# Generate with: openssl rand -base64 48
TAG_VISITOR_PEPPER=dev-only-tag-pepper

AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_LOGIN_ORIGIN_LIMIT=20
AUTH_REFRESH_FAMILY_LIMIT=10
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX_ENTRIES=10000
# Empty means forwarded headers are ignored. Set only controlled proxy networks.
# MUST include the frontend (Next) server's address: every public tag call and
# login arrives from it, and it forwards the visitor's IP in X-Forwarded-For
# (see the frontend's CLIENT_IP_HEADER). Left empty, the public tag and login
# rate limits are shared by every visitor (production logs a warning).
AUTH_TRUSTED_PROXY_CIDRS=
# Optional comma-separated replacement for the built-in offline starter list.
AUTH_PASSWORD_BLOCKLIST=
AUTH_SESSION_PURGE_INTERVAL=1h
AUTH_SESSION_PURGE_RETENTION=24h
AUTH_SESSION_PURGE_MAX_BATCHES=10
AUDIT_RETENTION=2160h
AUDIT_PURGE_INTERVAL=24h
AUDIT_PURGE_MAX_BATCHES=10

JWT_ACCESS_SECRET=change-me-with-32-random-bytes-access-token-value
JWT_REFRESH_SECRET=change-me-with-32-random-bytes-refresh-token-value
JWT_ACCESS_HOURS=1
JWT_REFRESH_HOURS=24
JWT_ISSUER=change-me-issuer
JWT_AUDIENCE=change-me-audience
JWT_LEEWAY_SECONDS=0
# hs256 (default) or ed25519. Keep HMAC until an overlap window is planned.
JWT_ALG=hs256
# Optional HMAC kids for rotation. Leave empty to mint legacy tokens without kid.
JWT_ACCESS_KID=
JWT_REFRESH_KID=
JWT_PREVIOUS_ACCESS_KID=
JWT_PREVIOUS_ACCESS_SECRET=
JWT_PREVIOUS_REFRESH_KID=
JWT_PREVIOUS_REFRESH_SECRET=
# Ed25519 files must be owner-only (0600). Access and refresh kids/keys stay distinct.
JWT_ED25519_ACCESS_KEY_PATH=
JWT_ED25519_REFRESH_KEY_PATH=
JWT_ED25519_PREVIOUS_ACCESS_PUB_PATH=
JWT_ED25519_PREVIOUS_REFRESH_PUB_PATH=
# When JWT_ALG=ed25519, keep HMAC verification until max(access,refresh) TTL elapses.
JWT_HMAC_OVERLAP=false

# Federated login (Authorization Code + PKCE). Disabled until explicitly enabled.
OIDC_ENABLED=false
OIDC_HTTP_TIMEOUT=10s
OIDC_TRANSACTION_TTL=10m
OIDC_GRANT_TTL=2m
OIDC_COOKIE_NAME=oidc_tx
OIDC_COOKIE_PATH=/v1/auth/oidc
# 32-byte AES key as 64 hex chars. Generate with: openssl rand -hex 32
OIDC_ENCRYPTION_KEY=
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_REDIRECT_URI=
# Exact allowlisted frontend destinations. No wildcards.
OIDC_GOOGLE_ALLOWED_DESTINATIONS=
