      "dot": "emerald",
      "title": "Orden de arranque",
      "items": [
        "Config válida → pool PostgreSQL → migraciones → rutas → escucha HTTP",
        "Readiness solo se activa cuando el servidor ya está construido"
      ]
    },
    {
      "dot": "rose",
      "title": "Apagado seguro",
