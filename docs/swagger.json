{
    "swagger": "2.0",
    "info": {
        "description": "API de Autenticación con JWT en Go con Arquitectura Hexagonal",
        "title": "Mi API en Golang",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/v1/auth",
    "paths": {
        "/v1/auth/login": {
            "post": {
                "description": "Autentica a un usuario y devuelve tokens JWT",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "User login",
                "parameters": [
                    {
                        "description": "Credenciales de inicio de sesión",
                        "name": "loginData",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.LoginRequestDto"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Tokens de acceso y refresh",
                        "schema": {
                            "$ref": "#/definitions/dto.AuthDto"
                        }
                    },
                    "400": {
                        "description": "Error en la petición",
                        "schema": {
                            "$ref": "#/definitions/dto.ResponseDto"
                        }
                    },
                    "401": {
                        "description": "Credenciales incorrectas",
                        "schema": {
                            "$ref": "#/definitions/dto.ResponseDto"
                        }
                    }
                }
            }
        },
        "/v1/auth/refresh-token": {
            "post": {
                "description": "Refreshes an expired access token using a refresh token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Refresh JWT token",
                "parameters": [
                    {
                        "description": "Refresh token",
                        "name": "refreshToken",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.RefreshTokenRequestDto"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "New tokens",
                        "schema": {
                            "$ref": "#/definitions/dto.AuthDto"
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "schema": {
                            "$ref": "#/definitions/dto.ResponseDto"
                        }
                    }
                }
            }
        },
        "/v1/roles": {
            "get": {
                "description": "Retrieves a paginated list of roles",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Roles"
                ],
                "summary": "Get all roles",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page number",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Page size",
                        "name": "pageSize",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of roles",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/dto.ResponseDto"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/roles.RolesPageResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Error retrieving roles",
                        "schema": {
                            "$ref": "#/definitions/dto.ResponseDto"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.LoginRequestDto": {
            "description": "Estructura esperada para autenticación de usuario",
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "description": "🔹 Ejemplo de correo",
                    "type": "string",
                    "example": "user@example.com"
                },
                "password": {
                    "description": "🔹 Ejemplo de contraseña",
                    "type": "string",
                    "example": "password123"
                }
            }
        },
        "auth.RefreshTokenRequestDto": {
            "description": "Estructura esperada para refrescar un token JWT",
            "type": "object",
            "required": [
                "refreshToken"
            ],
            "properties": {
                "refreshToken": {
                    "description": "🔹 Token de refresco",
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1..."
                }
            }
        },
        "dto.AuthDto": {
            "description": "Contiene los tokens generados tras una autenticación exitosa",
            "type": "object",
            "properties": {
                "accessToken": {
                    "description": "🔹 Token JWT de acceso",
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1..."
                },
                "refreshToken": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1..."
                }
            }
        },
        "dto.ResponseDto": {
            "description": "Modelo de respuesta estándar para los endpoints",
            "type": "object",
            "properties": {
                "data": {
                    "description": "🔹 Datos dinámicos según el endpoint"
                },
                "message": {
                    "description": "🔹 Mensaje descriptivo de la respuesta",
                    "type": "string",
                    "example": "Ok"
                },
                "status": {
                    "description": "🔹 Código HTTP de respuesta",
                    "type": "integer",
                    "example": 200
                }
            }
        },
        "roles.PermissionResponse": {
            "description": "PermissionResponse represents a permission response.",
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "delete": {
                    "type": "boolean"
                },
                "entity": {
                    "type": "string"
                },
                "read": {
                    "type": "boolean"
                },
                "update": {
                    "type": "boolean"
                }
            }
        },
        "roles.RoleResponse": {
            "description": "RoleResponse represents a role response.",
            "type": "object",
            "properties": {
                "active": {
                    "type": "boolean"
                },
                "createdAt": {
                    "type": "string"
                },
                "createdBy": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "messagesDefault": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "permissions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/roles.PermissionResponse"
                    }
                },
                "routes": {
                    "type": "array",
                    "items": {
                        "description": "Enumeración de rutas en el sistema",
                        "type": "string"
                    }
                },
                "updatedAt": {
                    "type": "string"
                },
                "updatedBy": {
                    "type": "string"
                }
            }
        },
        "roles.RolesPageResponse": {
            "description": "RolesPageResponse represents a paginated response of roles.",
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/roles.RoleResponse"
                    }
                },
                "page": {
                    "type": "integer"
                },
                "pageSize": {
                    "type": "integer"
                },
                "totalItems": {
                    "type": "integer"
                },
                "totalPages": {
                    "type": "integer"
                }
            }
        }
    }
}